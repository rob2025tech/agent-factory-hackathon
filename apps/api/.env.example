# apps/api/.env.example
#
# Copy to apps/api/.env and fill in what you need. Every setting in
# config/settings.py has a default, so the app runs with an empty .env.
# Never commit a real .env or real keys.

# Ollama (default LLM provider for the active /execute pipeline)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b

# Provider selection for the active /execute pipeline
MEMORY_PROVIDER=evermind
LLM_PROVIDER=ollama

# Inactive settings: the storage and analytics providers are frozen
# scaffolding (ADR-015) — nothing reads these keys.
STORAGE_PROVIDER=local
ANALYTICS_PROVIDER=local

# External service keys (leave blank to disable the integration)
EVERMIND_API_KEY=
# Not consumed by anything currently (orphan key; see architecture.md §8).
NEBIUS_API_KEY=
# Gates registration of the legacy cerebras adapter only (ADR-013).
CEREBRAS_API_KEY=

# Butterbase storage service (behind the /butterbase router)
BUTTERBASE_API_BASE=
BUTTERBASE_API_KEY=
